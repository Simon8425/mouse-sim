ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('quarter disk with rational b-spline edge'),'2;1');
FILE_NAME('quarter_disk_bspline.step','2026-08-06T00:00:00',('Author'),(''),'','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('A',(0.,0.,0.));
#2=CARTESIAN_POINT('B',(10.,0.,0.));
#3=CARTESIAN_POINT('C',(10.,10.,0.));
#4=CARTESIAN_POINT('C1',(10.,10.,0.));
#5=CARTESIAN_POINT('C2',(10.,0.,0.));
#6=CARTESIAN_POINT('C3',(0.,0.,0.));
#7=VERTEX_POINT('VA',#1);
#8=VERTEX_POINT('VB',#2);
#9=VERTEX_POINT('VC',#3);
#10=EDGE_CURVE('StraightAB',#7,#8,$,.T.);
#11=EDGE_CURVE('StraightBC',#8,#9,$,.T.);
#12=EDGE_CURVE('SplineCA',#9,#7,#40,.T.);
#20=ORIENTED_EDGE('O1',*,*,#10,.T.);
#21=ORIENTED_EDGE('O2',*,*,#11,.T.);
#22=ORIENTED_EDGE('O3',*,*,#12,.T.);
#30=EDGE_LOOP('Quarter',(#20,#21,#22));
#31=FACE_OUTER_BOUND('B1',#30);
#32=ADVANCED_FACE('F1',(#31),$,.T.);
#33=CLOSED_SHELL('Shell1',(#32));
#34=MANIFOLD_SOLID_BREP('QuarterDisk',#33);
#40=B_SPLINE_CURVE_WITH_KNOTS_AND_RATIONAL('Arc',2,(#4,#5,#6),.UNSPECIFIED.,.F.,.F.,(3,3),(0.E0,1.E0),.UNSPECIFIED.,(1.,0.7071067811865476,1.));
#50=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#51=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#52=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#53=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-06),#50,'distance_accuracy_value','confusion accuracy');
#54=GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#53))GLOBAL_UNIT_ASSIGNED_CONTEXT((#50,#51,#52));
ENDSEC;
END-ISO-10303-21;
